# Database
DATABASE_URL=postgres://code_terroir:change-me@localhost:5432/code_terroir_dev
DOCKER_DATABASE_URL=postgres://code_terroir:change-me@postgres:5432/code_terroir_dev
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379

# Server
SERVER_PORT=3030
BASE_URL=http://localhost:3030

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_HOURS=24
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:8081
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# File Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# SMTP (for notifications and password reset)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Code Terroir

# Logging
RUST_LOG=code_terroir=debug,warp=info,sqlx=info,tower=info

# Security
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# QR Codes & Short URLs
QR_BASE_URL=https://your-domain.com/t
QR_DEFAULT_SIZE=256

# PDF Generation
PDF_TEMPLATE_DIR=./templates/pdf

# Development only
DEV_SEED_DATA=true
DEV_AUTO_MIGRATE=true
